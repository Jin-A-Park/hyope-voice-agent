# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Required ---

# Shared secret this server expects on internal requests (e.g. from worker.py).
INTERNAL_API_KEY=

# xAI (Grok) API key, used for the realtime voice session.
XAI_API_KEY=

# Publicly reachable base URL of this server (used to build callback/webhook URLs).
PUBLIC_BASE_URL=

# ClawOps (Twilio-compatible) telephony credentials.
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_SIGNING_KEY=
CLAWOPS_FROM_NUMBER=

# Google Gemini API key (only required if using a gemini-* realtime model).
GEMINI_API_KEY=

# Kakao Local API REST key (developers.kakao.com) — used to resolve nearby help
# resources from a recipient's address before a call. Optional: without it,
# nearby-resource lookup is skipped and a static national hotline list is used instead.
KAKAO_API_KEY=

# --- Optional (defaults shown) ---

# xAI realtime endpoint/model.
XAI_REALTIME_BASE_URL=wss://api.x.ai/v1/realtime
XAI_BASE_URL=https://api.x.ai/v1
REALTIME_MODEL=grok-voice-latest

# Gemini realtime endpoint.
GEMINI_REALTIME_BASE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent

# Text-to-speech voice selection.
TTS_VOICE=ara
GEMINI_TTS_VOICE=Kore

# Voice activity detection tuning.
VAD_THRESHOLD=0.5
PREFIX_MS=300
SILENCE_MS=900
IDLE_TIMEOUT_MS=30000

# Spring backend URL — worker.py POSTs call results and high-severity emergency alerts here.
SPRING_BASE_URL=http://localhost:8080
